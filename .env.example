POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_support_agent

# Port 5433, not 5432 — see backend/docker-compose.yaml.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/rag_support_agent
FRONTEND_ORIGIN=http://localhost:3000

# Job queue. Document preparation is enqueued here and run by worker.py.
REDIS_URL=redis://localhost:6379/0


JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting, counted in Redis. Auth is limited per client address,
# chat per organization — chat is the OpenAI spend path.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_MAX_REQUESTS=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60


UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
# Leave false so the prepare endpoint owns extraction and indexing as one step.
AUTO_INGEST_ON_UPLOAD=false
CHUNK_SIZE=1200
CHUNK_OVERLAP=200


OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
INDEX_BATCH_SIZE=50


CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.2
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
